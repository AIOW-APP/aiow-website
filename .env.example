# Operations admin is fail-closed: all four names must be configured server-side.
# The deployment host is an exact lowercase hostname without a scheme or port.
# Keep credentials secret; missing or malformed configuration conceals admin routes with 404.
AIOW_OPS_DEPLOYMENT_HOST=
AIOW_OPS_BASIC_USERNAME=
AIOW_OPS_BASIC_PASSWORD=
AIOW_OPS_OPERATOR_ID=

# Quote API -> durable adapter. Keep unset to fail closed.
AIOW_QUOTE_WEBHOOK_URL=
AIOW_QUOTE_WEBHOOK_SECRET=

# Supabase/PostgREST durable store. Service-role key is server-only.
AIOW_SUPABASE_URL=
AIOW_SUPABASE_SERVICE_ROLE_KEY=

# Outbox worker authorization. CRON_SECRET may be accepted as an alternate bearer.
AIOW_QUOTE_WORKER_SECRET=
CRON_SECRET=

# Google Workspace domain-wide delegation. Keep unset until owner-approved activation.
AIOW_GOOGLE_SERVICE_ACCOUNT_EMAIL=
AIOW_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
AIOW_GOOGLE_DELEGATED_SUBJECT=offerte@aiow.ai

# Local proof only. Production must never set this flag or override provider URLs.
AIOW_QUOTE_ADAPTER_TEST_MODE=
AIOW_QUOTE_PROVIDER_TEST_MODE=
AIOW_GOOGLE_TOKEN_URL=
AIOW_GMAIL_SEND_URL=

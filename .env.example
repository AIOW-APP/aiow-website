# AIOW Website environment template
# Do not store real secrets here.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional integrations should be supplied via secure local environment / deployment platform.
# Examples by name only, no values:
# RESEND_API_KEY=
AIOW_SUPABASE_URL=
AIOW_SUPABASE_SERVICE_ROLE_KEY=
# Required in deployed environments: random secret of at least 32 characters, used only for HMAC hashing.
AIOW_VENTURE_INTAKE_HASH_SECRET=
# Local development/tests only. Never configure this file-backed adapter in production or on Vercel.
# AIOW_VENTURE_INTAKE_LOCAL_TEST=1
# AIOW_VENTURE_INTAKE_LOCAL_STORE=/absolute/path/outside-the-repository/venture-intake-state.json
SPUNKY_CHAT_WEBHOOK_URL=
SPUNKY_CHAT_WEBHOOK_TOKEN=
# OPENAI_API_KEY=

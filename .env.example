# Operations admin is fail-closed: all four names must be configured server-side.
# The deployment host is the stable production Vercel alias as an exact lowercase
# hostname without a scheme or port (for example, aiow-main-site.vercel.app).
# Vercel independently binds each request to its immutable VERCEL_URL deployment.
# Keep credentials secret; missing or malformed configuration conceals admin routes with 404.
AIOW_OPS_DEPLOYMENT_HOST=
AIOW_OPS_BASIC_USERNAME=
AIOW_OPS_BASIC_PASSWORD=
AIOW_OPS_OPERATOR_ID=

# Public quote/booking APIs -> exact HTTPS internal adapter routes. The URL paths
# must be /api/internal/quote-adapter and /api/internal/booking-adapter respectively.
# Do not use a site root, redirect, or provider endpoint. Keep unset to fail closed.
AIOW_QUOTE_WEBHOOK_URL=
AIOW_QUOTE_WEBHOOK_SECRET=
AIOW_BOOKING_WEBHOOK_URL=
AIOW_BOOKING_WEBHOOK_SECRET=

# Supabase/PostgREST durable store. Service-role key is server-only.
AIOW_SUPABASE_URL=
AIOW_SUPABASE_SERVICE_ROLE_KEY=

# Outbox worker authorization. Legacy quote worker remains v1 test-only.
AIOW_QUOTE_WORKER_SECRET=
AIOW_MAIL_WORKER_SECRET=
AIOW_MAIL_WORKER_ID=aiow-mail-outbox-v2
CRON_SECRET=

# Microsoft Graph v2 production provider. No combination of Graph environment
# variables activates sending without the current, owner-approved DB provider gate;
# scoped Exchange Application RBAC evidence must also validate before every provider call.
# Sender/mailbox are exact.
AIOW_MICROSOFT_TENANT_ID=
AIOW_MICROSOFT_APPLICATION_ID=
AIOW_MICROSOFT_CLIENT_SECRET=
AIOW_MICROSOFT_MAILBOX=info@aiow.io
AIOW_MICROSOFT_SENDER=info@aiow.io
AIOW_MICROSOFT_CONTROL_MAILBOX=

# Google Workspace/Gmail is legacy v1 test-only and cannot be selected by v2.
AIOW_GOOGLE_SERVICE_ACCOUNT_EMAIL=
AIOW_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
AIOW_GOOGLE_DELEGATED_SUBJECT=offerte@aiow.ai

# Local proof only. Production must never set this flag or override provider URLs.
AIOW_QUOTE_ADAPTER_TEST_MODE=
AIOW_QUOTE_PROVIDER_TEST_MODE=
AIOW_MAIL_PROVIDER_TEST_MODE=
AIOW_MICROSOFT_TOKEN_URL=
AIOW_MICROSOFT_GRAPH_SEND_URL=
AIOW_GOOGLE_TOKEN_URL=
AIOW_GMAIL_SEND_URL=
